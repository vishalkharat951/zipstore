# =============================================================================
# ZipStore Backend API - Oracle Cloud (OCI) environment
# =============================================================================
# Copy this file to zipstore-backend/.env on the OCI VM and fill in real values.
#   cp deploy/oracle/env.oci.example zipstore-backend/.env
# IMPORTANT: JWT_SECRET, PHONEPE_SALT_KEY and any DB password must be random,
# strong values - never reuse the ones from this example.
# =============================================================================

PORT=5000
# Points at the mongo service inside the compose network.
MONGODB_URI=mongodb://mongo:27017/zipstore

# Random 32+ char string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-jwt-secret

# Comma-separated list of browser origins allowed to call the API.
# At minimum the frontend origin(s). Use * only if you accept the trade-off.
ALLOWED_ORIGINS=https://zipsto.net,https://www.zipsto.net,https://vishalkharat951.github.io

# Set to "development" ONLY on your laptop (disables origin checks).
NODE_ENV=production

# Your UPI VPA shown on the "Pay by UPI" QR, e.g. yourname@oksbi
UPI_ID=8669303401@ybl

# ---------- PhonePe Payment Gateway ----------
PHONEPE_MERCHANT_ID=change-me
PHONEPE_SALT_KEY=change-me
PHONEPE_SALT_INDEX=1
# "test" (UAT) or "production"
PHONEPE_ENV=test
# Must be the HTTPS callback reachable by PhonePe, e.g.:
PHONEPE_CALLBACK_URL=https://api.yourdomain.com/api/payments/phonepe-callback
# Where the user is redirected after PhonePe payment.
FRONTEND_URL=https://zipsto.net
