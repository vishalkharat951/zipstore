# =============================================================================
# ZipStore Backend API - environment configuration
# =============================================================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# IMPORTANT: JWT_SECRET, PHONEPE_SALT_KEY and any DB password must be strong,
# random values. NEVER commit the real .env file.
# =============================================================================

PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/zipstore

# Random 32+ char string. Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=https://your-frontend.github.io,http://localhost:3000

# Set to "development" ONLY on your laptop (disables strict origin checks)
NODE_ENV=production

# ---------- App URLs ----------
# Base URL of the backend API (used to build absolute callback URLs)
API_URL=https://your-backend.onrender.com
# Base URL of the frontend (where users are redirected after payment)
FRONTEND_URL=https://your-frontend.github.io

# ---------- Direct UPI (optional QR fallback) ----------
# Your UPI VPA shown on the "Pay by UPI" QR, e.g. yourname@oksbi.
# Leave empty to disable the UPI QR until you have one.
UPI_ID=
MERCHANT_NAME=ZipStore

# ---------- PhonePe Payment Gateway ----------
# Get these from the PhonePe Business dashboard after onboarding.
# NEVER commit the real salt key; read it from .env only.
# Leave PHONEPE_MERCHANT_ID / PHONEPE_SALT_KEY empty until you onboard,
# otherwise payments will be disabled with a clear error.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# "test" (UAT sandbox) or "production" (live payments)
PHONEPE_ENV=test

# HTTPS endpoint that PhonePe calls back to after payment.
# Must be publicly reachable and match exactly what you register with PhonePe.
# Required when PHONEPE_ENV=production.
PHONEPE_CALLBACK_URL=

# Where the user is redirected after PhonePe payment completes
PHONEPE_REDIRECT_URL=

# Optional shared secret for an extra webhook layer (sent as
# X-ZIPSTORE-WEBHOOK-SECRET). PhonePe's X-VERIFY is the primary check.
PHONEPE_WEBHOOK_SECRET=change-me-to-a-long-random-string
